# Local development settings. Replace values as appropriate before use.
APP_ENV=development
DATABASE_URL=sqlite:///./jenga_consultants.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
JENGA_SECRET_KEY=replace-with-a-long-random-development-secret
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
ENABLE_HOSTED_MEDIA=false
# Selecting a local endpoint prevents hosted fallback and hosted media processing.
LLM_BASE_URL=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=180
LLM_MAX_TOKENS=1024
# Configure verified native executables/models before local media inference.
TESSERACT_CMD=tesseract
WHISPER_CPP_CMD=whisper-cli
WHISPER_MODEL_PATH=
PORT=8000
